{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "api",
      "framework": "express"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api",
        "path": "/api/:path*"
      }
    },
    {
      "source": "/:dir*/:file.:ext",
      "destination": {
        "service": "frontend",
        "path": "/:dir*/:file.:ext"
      }
    },
    {
      "source": "/:file.:ext",
      "destination": {
        "service": "frontend",
        "path": "/:file.:ext"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ]
}
